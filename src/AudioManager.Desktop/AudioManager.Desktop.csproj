<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Resources\Icons\mixdeck.ico</ApplicationIcon>
    <Version>0.1.1</Version>
    <AssemblyVersion>0.1.1.0</AssemblyVersion>
    <FileVersion>0.1.1.0</FileVersion>
    <Product>MixDeck</Product>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Resources\Icons\mixdeck.ico" />
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <InternalsVisibleTo Include="AudioManager.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../AudioManager.Core/AudioManager.Core.csproj" />
    <ProjectReference Include="../AudioManager.Windows/AudioManager.Windows.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.13" />
  </ItemGroup>

</Project>
