<UserControl x:Class="AudioManager.Desktop.Views.AdvancedOptionsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,12,0,0">
            <TextBlock x:Name="FocusAnchor" Text="高级选项" FontSize="24" FontWeight="SemiBold" Focusable="True"/>
            <TextBlock Text="管理外观、窗口行为和已记忆的音量设置。" Margin="0,4,0,16" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
            <Border Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0" Visibility="{Binding Appearance, Converter={StaticResource NotNullToVisibility}}">
                        <TextBlock Text="外观主题" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding Appearance.Options}" SelectedValue="{Binding Appearance.Mode}" SelectedValuePath="Mode" DisplayMemberPath="Label" AutomationProperties.Name="外观主题"/>
                        <TextBlock Text="{Binding Appearance.Description}" Style="{StaticResource SecondaryTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Appearance.Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" Visibility="{Binding Appearance.Error, Converter={StaticResource NotNullToVisibility}}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="常用偏好" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,8"/>
                        <CheckBox Content="登录后启动到托盘" IsChecked="{Binding StartAtLogin}" Margin="0,0,0,8"/>
                        <CheckBox Content="显示不可用设备" IsChecked="{Binding ShowUnavailableDevices}"/>
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding WindowBehavior, Converter={StaticResource NotNullToVisibility}}">
                            <TextBlock Text="点击窗口关闭按钮时" Margin="0,0,0,7"/>
                            <ComboBox ItemsSource="{Binding WindowBehavior.Options}" SelectedValue="{Binding WindowBehavior.Mode}" SelectedValuePath="Mode" DisplayMemberPath="Label" AutomationProperties.Name="窗口关闭方式"/>
                            <TextBlock Text="{Binding WindowBehavior.Error}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="{Binding WindowBehavior.Error, Converter={StaticResource NotNullToVisibility}}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border CornerRadius="8" Padding="12,8" Margin="0,12,0,16">
                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SubtleAccentBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasOperationError}" Value="True"><Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style>
                <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.Name="配置操作结果">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasOperationError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Border>
            <Expander x:Name="MemorySettings" IsExpanded="False">
                <Expander.Header><TextBlock Text="已记忆的音量设置" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold"/></Expander.Header>
                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="收起仅隐藏列表，音量仍会自动保存和恢复。" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="导入" Command="{Binding ImportCommand}" Padding="9,4" MinHeight="28" Margin="0,0,6,0"/>
                        <Button Content="导出" Command="{Binding ExportCommand}" Padding="9,4" MinHeight="28" Margin="0,0,6,0"/>
                        <Button Content="恢复默认" Command="{Binding ResetCommand}" Padding="9,4" MinHeight="28" Foreground="{DynamicResource ErrorBrush}" ToolTip="重置音量记忆及相关音频偏好；主题和窗口关闭方式保持不变。"/>
                    </WrapPanel>
                    <DataGrid x:Name="RememberedVolumes" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False"
                        CanUserDeleteRows="False" CanUserSortColumns="False" CanUserResizeColumns="True" HeadersVisibility="Column"
                        RowHeaderWidth="0" RowHeight="38" Height="240" MinHeight="80" GridLinesVisibility="Horizontal"
                        HorizontalGridLinesBrush="{DynamicResource GridLineBrush}" BorderThickness="0"
                        Background="{DynamicResource CardBackgroundBrush}" AlternatingRowBackground="{DynamicResource SoftSurfaceBrush}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                        EnableRowVirtualization="True" AutomationProperties.Name="已记忆的音量设置">
                        <DataGrid.CellStyle><Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}"><Setter Property="ClipToBounds" Value="True"/></Style></DataGrid.CellStyle>
                        <DataGrid.Resources><Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                        </Style></DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="启用" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="项目" Binding="{Binding Name}" IsReadOnly="True" Width="SizeToCells" MinWidth="170"/>
                            <DataGridTemplateColumn Header="目标 %" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <TextBox Text="{Binding VolumeText, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="OnVolumeKeyDown" LostKeyboardFocus="OnVolumeLostFocus"
                                    AutomationProperties.Name="规则目标音量" ToolTip="输入 0～100；回车或离开输入框自动保存，Esc 取消"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="静音" Width="52"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <CheckBox IsChecked="{Binding IsMuted, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            <DataGridTextColumn Header="应用匹配（完整路径）" Binding="{Binding Match}" IsReadOnly="True" Width="SizeToCells" MinWidth="360"/>
                            <DataGridTextColumn Header="输出设备" Binding="{Binding DeviceName}" IsReadOnly="True" Width="SizeToCells" MinWidth="260"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>
            <WrapPanel Margin="0,16,0,8">
                <Button Content="检查音量状态" Command="{Binding InspectCommand}" Padding="10,5" Margin="0,0,8,6" ToolTip="比较已记忆的目标与当前音量，结果见系统日志。"/>
                <Button Content="重新应用音量设置" Command="{Binding ReapplyCommand}" Padding="10,5" Margin="0,0,0,6" ToolTip="重新应用当前设备已启用的音量设置。"/>
            </WrapPanel>
            <TextBlock Text="配置文件位置" Margin="0,6,0,0" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" ToolTip="{Binding ConfigurationPath}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
