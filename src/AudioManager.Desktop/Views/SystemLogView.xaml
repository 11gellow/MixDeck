<UserControl x:Class="AudioManager.Desktop.Views.SystemLogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:AudioManager.Desktop.ViewModels">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,16">
            <TextBlock Text="系统日志" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="查看本次运行的事件与操作记录。" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OperationEntry}">
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                    <Border Grid.Column="1" Background="{DynamicResource MutedSurfaceBrush}" CornerRadius="4" Margin="0,0,10,0" VerticalAlignment="Top"
                                            Visibility="{Binding Source, Converter={StaticResource NotNullToVisibility}}">
                                        <TextBlock Text="{Binding Source}" FontSize="11" HorizontalAlignment="Center" Foreground="{DynamicResource SecondaryTextBrush}"/>
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" FontSize="12">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="暂无记录" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers>
                        <DataTrigger Binding="{Binding Entries.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </Grid>
</UserControl>
