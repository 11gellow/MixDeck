<Window x:Class="AudioManager.Desktop.Views.ConfigurationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="方案与自动恢复" Width="820" Height="700" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="方案与自动恢复" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,8" Text="保存全部可用输出设备的当前音量。已保存快照不会随实时状态改变。" TextWrapping="Wrap" />
            <TextBlock Text="{Binding CurrentProfileName, StringFormat=当前方案：{0}}" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,12,0,10">
            <WrapPanel>
                <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" Width="150" Margin="0,0,8,6" Padding="6" AutomationProperties.Name="新方案名称" />
                <Button Content="保存当前音量为新方案" Command="{Binding SaveSnapshotCommand}" Padding="10,4" Margin="0,0,8,6" />
                <Button Content="导入" Command="{Binding ImportCommand}" Padding="10,4" Margin="0,0,8,6" />
                <Button Content="导出" Command="{Binding ExportCommand}" Padding="10,4" Margin="0,0,8,6" />
                <Button Content="恢复默认" Command="{Binding ResetCommand}" Padding="10,4" Margin="0,0,0,6" />
            </WrapPanel>
            <WrapPanel>
                <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                          Width="190" Margin="0,0,8,6" AutomationProperties.Name="已保存方案" />
                <Button Content="设为当前方案" Command="{Binding ActivateCommand}" Padding="10,4" Margin="0,0,8,6" />
                <Button Content="手动恢复快照" Command="{Binding RestoreCommand}" Padding="10,4" Margin="0,0,8,6" />
                <Button Content="删除方案" Command="{Binding DeleteCommand}" Padding="10,4" Margin="0,0,0,6" />
            </WrapPanel>
            <TextBlock Text="{Binding SelectedProfileDetails}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" />
        </StackPanel>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <Button DockPanel.Dock="Right" Content="保存规则目标" Command="{Binding SaveRulesCommand}" Padding="10,4" />
                <TextBlock Text="自动恢复规则" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" AutoGenerateColumns="False" CanUserAddRows="False"
                      CanUserDeleteRows="False" CanUserSortColumns="False" HeadersVisibility="Column"
                      RowHeaderWidth="0" RowHeight="30" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E5E5E5"
                      Height="240" MinHeight="80" EnableRowVirtualization="True" AutomationProperties.Name="方案恢复规则">
                <DataGrid.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                    <DataGridTextColumn Header="项目" Binding="{Binding Name}" IsReadOnly="True" Width="140" />
                    <DataGridTextColumn Header="目标 %" Binding="{Binding VolumeText, UpdateSourceTrigger=PropertyChanged}" Width="75" />
                    <DataGridCheckBoxColumn Header="静音" Binding="{Binding IsMuted, UpdateSourceTrigger=PropertyChanged}" Width="48" />
                    <DataGridTextColumn Header="应用匹配（完整路径）" Binding="{Binding Match}" IsReadOnly="True" Width="*" />
                    <DataGridTextColumn Header="输出设备" Binding="{Binding DeviceName}" IsReadOnly="True" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="启用后以规则目标为准，外部音量改变会被恢复。主界面中的受管项目需在此修改目标。系统拒绝修改时显示实际值并停止重试，可点击主窗口“刷新”重试。" TextWrapping="Wrap" FontSize="12" />
                <WrapPanel Margin="0,8,0,0">
                    <CheckBox Content="启用当前方案自动恢复" IsChecked="{Binding AutomaticRestore}" Margin="0,0,16,8" />
                    <CheckBox Content="登录后启动到托盘" IsChecked="{Binding StartAtLogin}" Margin="0,0,16,8" />
                    <CheckBox Content="显示不可用设备" IsChecked="{Binding ShowUnavailableDevices}" Margin="0,0,0,8" />
                </WrapPanel>
                <Button Content="保存设置" Command="{Binding SaveSettingsCommand}" HorizontalAlignment="Left" Padding="12,4" />
            </StackPanel>
            <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource WarningBrush}" AutomationProperties.Name="配置操作结果" />
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding ConfigurationPath}" TextWrapping="Wrap" Margin="0,10,0,0" FontSize="11"
                   Foreground="{StaticResource SecondaryTextBrush}" ToolTip="配置文件位置；备份位于同目录" />
    </Grid>
    </ScrollViewer>
</Window>
