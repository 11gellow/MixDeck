<Window x:Class="AudioManager.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AudioManager.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Windows Audio Manager（暂定）"
        Width="880" Height="680" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        Foreground="{StaticResource PrimaryTextBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="音量管理" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="管理输出设备、系统主音量和各应用音量。状态随 Windows 音频事件实时同步。" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" FontSize="11" TextWrapping="Wrap"
                           Text="音量为 Windows 音频 API 数值，不代表最终听感。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 实时同步状态 -->
                <Border Padding="10,5" CornerRadius="14" Margin="0,0,12,0" ToolTip="{Binding StateVersionText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#EDEDED" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SyncState}" Value="Live">
                                    <Setter Property="Background" Value="#DFF6DD" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SyncState}" Value="Degraded">
                                    <Setter Property="Background" Value="#FFF4CE" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SyncState}" Value="Offline">
                                    <Setter Property="Background" Value="#FDE7E9" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{StaticResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncState}" Value="Live">
                                            <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SyncState}" Value="Degraded">
                                            <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SyncState}" Value="Offline">
                                            <Setter Property="Fill" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SyncStatusText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ProgressBar Width="60" Height="3" Margin="0,0,12,0" IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}" Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <Button Style="{StaticResource AccentButtonStyle}" Command="{Binding RefreshCommand}"
                        ToolTip="重新枚举设备并重试失效的监听；监听未运行时重新启动 (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextStyle}" FontSize="13" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 输出设备与系统主音量 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出设备" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" AutomationProperties.Name="管理的输出设备">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItemViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="#E6F0FA"
                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="默认" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="#FFF4CE"
                                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="2" Content="显示不可用端点" VerticalAlignment="Center" Margin="16,0,0,0"
                              IsChecked="{Binding ShowUnavailableDevices}" />
                </Grid>

                <TextBlock Margin="0,8,0,0" FontSize="12" Text="{Binding DeviceStatusText}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeviceWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <Separator Margin="0,12" Background="{StaticResource CardBorderBrush}" />

                <Grid IsEnabled="{Binding HasMasterVolume}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Left"
                            Command="{Binding ToggleMasterMuteCommand}" AutomationProperties.Name="系统主静音开关">
                        <Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="静音" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMasterMuted}" Value="True">
                                                <Setter Property="Text" Value="取消静音" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                                    <Setter Property="Text" Value="&#xE767;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasterMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;" />
                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="系统主音量" Style="{StaticResource SectionTitleStyle}" />
                            <Border Style="{StaticResource ExternalBadgeStyle}"
                                    Visibility="{Binding MasterExternalChangeText, Converter={StaticResource NotNullToVisibility}}"
                                    ToolTip="由 Windows 音量混合器、其他程序或系统修改">
                                <TextBlock Text="{Binding MasterExternalChangeText}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding SelectedDevice.Name}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <Slider Grid.Column="2" Style="{StaticResource VolumeSliderStyle}" Margin="0,0,12,0"
                            Value="{Binding MasterVolume}" AutomationProperties.Name="系统主音量" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="14"
                               Text="{Binding MasterVolume, StringFormat={}{0:0}%}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 应用列表标题 -->
        <Grid Grid.Row="2" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="应用音量" Style="{StaticResource SectionTitleStyle}" />
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="7,1" CornerRadius="9" Background="#E5E5E5"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Sessions.Count}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasReadIssues, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{Binding ReadIssueDetails}">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="12" Text="&#xE7BA;"
                           Foreground="{StaticResource WarningBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ReadIssueSummary}" FontSize="12" Foreground="{StaticResource WarningBrush}" />
            </StackPanel>
        </Grid>

        <!-- 应用会话列表 -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6" Padding="12,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="250" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="32" Height="32" HorizontalAlignment="Left">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding Icon, Converter={StaticResource NotNullToVisibility}}" />
                                        <Border CornerRadius="6" Background="#EDEDED"
                                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Foreground="{StaticResource SecondaryTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                                                        <Setter Property="Text" Value="&#xE8D6;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSystemSounds}" Value="True">
                                                                <Setter Property="Text" Value="&#xE7F4;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                                ToolTip="{Binding ProcessPath, TargetNullValue=程序路径不可读}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ExternalBadgeStyle}"
                                                    Visibility="{Binding ExternalChangeText, Converter={StaticResource NotNullToVisibility}}"
                                                    ToolTip="由 Windows 音量混合器、其他程序或系统修改">
                                                <TextBlock Text="{Binding ExternalChangeText}" FontSize="11" Foreground="{StaticResource WarningBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Left"
                                            Command="{Binding ToggleMuteCommand}" AutomationProperties.Name="{Binding DisplayName, StringFormat={}{0} 静音开关}">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="静音" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Text" Value="取消静音" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                                                    <Setter Property="Text" Value="&#xE767;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Text" Value="&#xE74F;" />
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <Slider Grid.Column="3" Style="{StaticResource VolumeSliderStyle}" Margin="0,0,12,0"
                                            Value="{Binding Volume}" AutomationProperties.Name="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right"
                                               Text="{Binding Volume, StringFormat={}{0:0}%}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowEmptySessions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="32" Text="&#xE8D6;"
                           Foreground="{StaticResource TrackBrush}" />
                <TextBlock Margin="0,8,0,0" Text="当前设备没有正在使用音频的应用"
                           Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 操作反馈 -->
        <Expander Grid.Row="4" Margin="0,10,0,0">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="事件与操作记录" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Log.Latest.TimeText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding Log.Latest.Text}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="560">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Log.Latest.IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Expander.Header>
            <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0" Padding="10,6">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OperationEntry}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding TimeText}" Width="64" Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" />
                                    <Border Width="56" Margin="0,0,8,0" CornerRadius="4" Background="#EDEDED" VerticalAlignment="Top"
                                            Visibility="{Binding Source, Converter={StaticResource NotNullToVisibility}}">
                                        <TextBlock Text="{Binding Source}" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{StaticResource SecondaryTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>
        <DockPanel Grid.Row="5" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="退出程序" Padding="12,4" Click="OnExitClicked" />
            <TextBlock x:Name="LifetimeText" Text="" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
