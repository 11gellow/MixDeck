<Window x:Class="AudioManager.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:AudioManager.Desktop.Views"
        xmlns:vm="clr-namespace:AudioManager.Desktop.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="MixDeck"
        Width="940" Height="740" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        Foreground="{DynamicResource PrimaryTextBrush}">

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>

    <DockPanel Margin="24,20,24,14">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Button DockPanel.Dock="Right" Content="退出程序" Padding="12,4" Click="OnExitClicked" />
            <TextBlock x:Name="LifetimeText" Text="" VerticalAlignment="Center" TextWrapping="Wrap"
                       Style="{StaticResource SecondaryTextStyle}" Margin="0,0,12,0" />
        </DockPanel>
    <TabControl x:Name="Pages" Style="{StaticResource MainNavigationStyle}" SelectionChanged="OnPageChanged">
      <TabItem Header="音量管理">
    <ScrollViewer x:Name="MixerViewport" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid MinHeight="480" Height="{Binding ViewportHeight, ElementName=MixerViewport}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="音量管理" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="选择输出设备，分别调节各应用的音量。" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- 实时同步状态 -->
                <Border Padding="10,5" CornerRadius="14" Margin="0,0,12,0" ToolTip="{Binding StateVersionText}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource MutedSurfaceBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SyncState}" Value="Live">
                                    <Setter Property="Background" Value="{DynamicResource SuccessBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SyncState}" Value="Degraded">
                                    <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SyncState}" Value="Offline">
                                    <Setter Property="Background" Value="{DynamicResource ErrorBackgroundBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource SecondaryTextBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SyncState}" Value="Live">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SyncState}" Value="Degraded">
                                            <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding SyncState}" Value="Offline">
                                            <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding SyncStatusText}" FontSize="12" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <ProgressBar Width="60" Height="3" Margin="0,0,12,0" IsIndeterminate="True"
                             Foreground="{DynamicResource AccentBrush}" Background="Transparent" BorderThickness="0"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <Button Command="{Binding RefreshCommand}"
                        ToolTip="重新枚举设备并重试失效的监听；监听未运行时重新启动 (F5)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextStyle}" FontSize="13" Text="&#xE72C;" Margin="0,0,8,0" />
                        <TextBlock Text="刷新" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- 输出设备与系统主音量 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="输出设备" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <ComboBox Grid.Column="1" Height="34" VerticalContentAlignment="Center" Padding="8,0"
                              ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" IsEnabled="{Binding CanSelectOutput}"
                              ToolTip="选择后切换 Windows 输出设备，并应用该设备的音量方案" AutomationProperties.Name="Windows 输出设备">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DeviceItemViewModel}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource SubtleAccentBrush}"
                                            Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="默认" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4" Background="{DynamicResource WarningBackgroundBrush}"
                                            Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVisibility}}">
                                        <TextBlock Text="{Binding StateText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <CheckBox Grid.Column="2" Content="显示不可用端点" VerticalAlignment="Center" Margin="16,0,0,0"
                              IsChecked="{Binding ShowUnavailableDevices}" />
                </Grid>

                <DockPanel Margin="0,8,0,0">
                    <Button DockPanel.Dock="Right" Content="重新应用主音量" HorizontalAlignment="Right" Padding="8,4" MinHeight="28" Margin="12,0,0,0"
                            Command="{Binding ReapplyMasterVolumeCommand}" ToolTip="数值正常但声音异常时，重新写入当前实际主音量并回读，保留静音状态。" />
                <TextBlock FontSize="12" Text="{Binding DeviceStatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDeviceWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                </DockPanel>

                <Separator Margin="0,12" Background="{DynamicResource CardBorderBrush}" />

                <Grid IsEnabled="{Binding HasMasterVolume}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="48" />
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="56" />
                    </Grid.ColumnDefinitions>
                    <Button Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Left"
                            Command="{Binding ToggleMasterMuteCommand}" AutomationProperties.Name="系统主静音开关">
                        <Button.ToolTip>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="静音" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMasterMuted}" Value="True">
                                                <Setter Property="Text" Value="取消静音" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.ToolTip>
                        <TextBlock FontSize="18">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                                    <Setter Property="Text" Value="&#xE767;" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMasterMuted}" Value="True">
                                            <Setter Property="Text" Value="&#xE74F;" />
                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="系统主音量" Style="{StaticResource SectionTitleStyle}" />
                            <Border Style="{StaticResource ExternalBadgeStyle}"
                                    Visibility="{Binding MasterExternalChangeText, Converter={StaticResource NotNullToVisibility}}"
                                    ToolTip="由 Windows 音量混合器、其他程序或系统修改">
                                <TextBlock Text="{Binding MasterExternalChangeText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="当前设备的整体音量" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding MasterControlStatus}" Foreground="{DynamicResource WarningBrush}" FontSize="11" TextWrapping="Wrap" Visibility="{Binding MasterControlStatus, Converter={StaticResource NotNullToVisibility}}" />
                    </StackPanel>
                    <Slider Grid.Column="2" Style="{StaticResource VolumeSliderStyle}" Margin="0,0,12,0"
                            PreviewKeyDown="OnSliderKeyDown" PreviewKeyUp="OnSliderKeyUp" PreviewMouseWheel="OnSliderWheel"
                            Value="{Binding MasterVolume}" IsEnabled="{Binding CanControlMaster}" AutomationProperties.Name="系统主音量" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="18" FontWeight="SemiBold"
                               Text="{Binding MasterVolume, StringFormat={}{0:0}%}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- 应用列表标题 -->
        <Grid Grid.Row="2" Margin="2,0,2,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="应用音量" Style="{StaticResource SectionTitleStyle}" />
            <Border Grid.Column="1" Margin="8,0,0,0" Padding="7,1" CornerRadius="9" Background="{DynamicResource MutedSurfaceBrush}"
                    HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Sessions.Count}" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="{Binding HasReadIssues, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{Binding ReadIssueDetails}">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="12" Text="&#xE7BA;"
                           Foreground="{DynamicResource WarningBrush}" Margin="0,0,6,0" />
                <TextBlock Text="{Binding ReadIssueSummary}" FontSize="12" Foreground="{DynamicResource WarningBrush}" />
            </StackPanel>
        </Grid>

        <!-- 应用会话列表 -->
        <Grid Grid.Row="3">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionViewModel}">
                            <Border Style="{StaticResource SessionCardStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="1.1*" MinWidth="120" />
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Width="34" Height="34" HorizontalAlignment="Left">
                                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality"
                                               Visibility="{Binding Icon, Converter={StaticResource NotNullToVisibility}}" />
                                        <Border CornerRadius="6" Background="{DynamicResource MutedSurfaceBrush}"
                                                Visibility="{Binding Icon, Converter={StaticResource NullToVisibility}}">
                                            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                                                        <Setter Property="Text" Value="&#xE8D6;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSystemSounds}" Value="True">
                                                                <Setter Property="Text" Value="&#xE7F4;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0"
                                                ToolTip="{Binding ProcessPath, TargetNullValue=程序路径不可读}">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Style="{StaticResource ExternalBadgeStyle}"
                                                    Visibility="{Binding ExternalChangeText, Converter={StaticResource NotNullToVisibility}}"
                                                    ToolTip="由 Windows 音量混合器、其他程序或系统修改">
                                                <TextBlock Text="{Binding ExternalChangeText}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                            </Border>
                                            <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource SecondaryTextStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                        <TextBlock Text="{Binding ControlStatus}" FontSize="11" Foreground="{DynamicResource WarningBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ControlStatus}" Visibility="{Binding ControlStatus, Converter={StaticResource NotNullToVisibility}}" />
                                    </StackPanel>

                                    <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" HorizontalAlignment="Left"
                                            Command="{Binding ToggleMuteCommand}" AutomationProperties.Name="{Binding DisplayName, StringFormat={}{0} 静音开关}">
                                        <Button.ToolTip>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="静音" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                <Setter Property="Text" Value="取消静音" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button.ToolTip>
                                        <TextBlock>
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource IconTextStyle}">
                                                    <Setter Property="Text" Value="&#xE767;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                            <Setter Property="Text" Value="&#xE74F;" />
                                                            <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Button>

                                    <Slider Grid.Column="3" Style="{StaticResource VolumeSliderStyle}" Margin="0,0,12,0"
                                            PreviewKeyDown="OnSliderKeyDown" PreviewKeyUp="OnSliderKeyUp" PreviewMouseWheel="OnSliderWheel"
                                            Value="{Binding Volume}" IsEnabled="{Binding CanControl}" AutomationProperties.Name="{Binding DisplayName}" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="16" FontWeight="SemiBold"
                                               Text="{Binding Volume, StringFormat={}{0:0}%}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding ShowEmptySessions, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource IconTextStyle}" FontSize="32" Text="&#xE8D6;"
                           Foreground="{DynamicResource TrackBrush}" />
                <TextBlock Margin="0,8,0,0" Text="当前设备没有正在使用音频的应用"
                           Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 操作反馈 -->
        <Expander Grid.Row="4" Margin="0,10,0,0">
            <Expander.Header>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="事件与操作记录" FontWeight="SemiBold" Margin="0,0,12,0" />
                    <TextBlock Grid.Column="1" Text="{Binding Log.Latest.TimeText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="2" Text="{Binding Log.Latest.Text}" FontSize="12" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Log.Latest.IsError}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Expander.Header>
            <Border Style="{StaticResource CardStyle}" Margin="0,6,0,0" Padding="10,6">
                <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Log.Entries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:OperationEntry}">
                                <StackPanel Orientation="Horizontal" Margin="0,2">
                                    <TextBlock Text="{Binding TimeText}" Width="64" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" />
                                    <Border Width="56" Margin="0,0,8,0" CornerRadius="4" Background="{DynamicResource MutedSurfaceBrush}" VerticalAlignment="Top"
                                            Visibility="{Binding Source, Converter={StaticResource NotNullToVisibility}}">
                                        <TextBlock Text="{Binding Source}" FontSize="11" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Border>
                                    <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
        </Expander>

    </Grid>
    </ScrollViewer>
      </TabItem>
      <TabItem Header="高级选项"><views:AdvancedOptionsView DataContext="{Binding Configuration}" Loaded="AdvancedOptionsView_Loaded" /></TabItem>
    </TabControl>
    </DockPanel>
</Window>
